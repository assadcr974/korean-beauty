---
import { formatPrice, shopifyImage, type Product } from '@/lib/shopify';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const image = product.images[0];
const price = formatPrice(product.priceRange.minVariantPrice);
---

<a
  href={`/boutique/${product.handle}`}
  class="card group block"
  aria-label={`Voir ${product.title}`}
>
  <div class="aspect-square overflow-hidden bg-ecume">
    {image ? (
      <img
        src={shopifyImage(image.url, 800)}
        alt={image.altText ?? product.title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-muted text-sm">
        Aucune image
      </div>
    )}
  </div>
  <div class="p-5">
    <h3 class="font-display text-lg leading-tight mb-1">{product.title}</h3>
    <p class="text-jade font-medium">{price}</p>
  </div>
</a>
